# AgenteLegal FAST DEMO — GCP baseline

export LEGAL_GCP_PROJECT="proyectopersonal-480420"
export LEGAL_GCP_REGION="us-central1"
export LEGAL_CLOUD_RUN_SERVICE="agente-legal"
export LEGAL_ALLOW_UNAUTHENTICATED="true"
export LEGAL_ARTIFACT_REPOSITORY="agente-legal"
export LEGAL_IMAGE_NAME="agente-legal"
export LEGAL_IMAGE_TAG="latest"
export LEGAL_SERVICE_ACCOUNT="agente-legal@${LEGAL_GCP_PROJECT}.iam.gserviceaccount.com"

# Cloud Storage corpus/index artifacts
export LEGAL_GCS_BUCKET="proyectopersonal-480420-agente-legal"

# Retrieval embeddings
export LEGAL_EMBEDDING_MODEL="gemini-embedding-001"
export LEGAL_EMBEDDING_DIMENSIONS="768"
export LEGAL_MINIMUM_RETRIEVAL_SCORE="0.15"

# Generation model will be pinned in Sprint 2 after current platform validation.
export LEGAL_MODEL=""

export LEGAL_ENV="local"
export LEGAL_LOG_LEVEL="INFO"
export LEGAL_PORT="8080"
export LEGAL_CORPUS_PATH="data/contracts"
